# Copy to .env for local dev. In CI these are GitHub repository VARIABLES
# (Settings > Secrets and variables > Actions > Variables) — not secrets:
# both values are compiled into the public bundle and are meant to be seen.

# Leave empty and the form keeps its mail-draft behaviour.
PUBLIC_CONTACT_ENDPOINT=

# Leave empty and no bot check is rendered.
PUBLIC_TURNSTILE_SITE_KEY=
