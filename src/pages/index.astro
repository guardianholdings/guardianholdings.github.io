---
/**
 * The site. One page, ten acts, scroll as the only navigation.
 */
import Base from '../layouts/Base.astro';
import ActCarrier from '../components/ActCarrier.astro';
import ActUniverse from '../components/ActUniverse.astro';
import ActPhilosophy from '../components/ActPhilosophy.astro';
import ActProcess from '../components/ActProcess.astro';
import ActReadings from '../components/ActReadings.astro';
import ActProvide from '../components/ActProvide.astro';
import ActPortfolio from '../components/ActPortfolio.astro';
import ActAdvisory from '../components/ActAdvisory.astro';
import ActWatch from '../components/ActWatch.astro';
import ActChannel from '../components/ActChannel.astro';
---
<Base instrument>
  <ActCarrier />
  <ActUniverse />
  <ActPhilosophy />
  <ActProcess />
  <ActReadings />
  <ActProvide />
  <ActPortfolio />
  <ActAdvisory />
  <ActWatch />
  <ActChannel />
</Base>

{/* The three panels that hold a track wider than the frame below 768px.
    initScroller only makes one focusable when it genuinely overflows, so
    above the breakpoint — where all three are overflow:hidden — this adds
    no tab stops. Labels name what the panel holds, not that it scrolls;
    the module appends the scrolling part. */}
<script>
  import { initScroller } from '../scripts/scrollers';

  initScroller('.matrix__scroll', 'Investment universe matrix');
  initScroller('.process__viewport', 'Process, four steps');
  initScroller('.provide__viewport', 'Operating functions');
</script>
