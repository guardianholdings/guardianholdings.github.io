---
import { Font } from 'astro:assets';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { COMPANY, META } from '../data/content';
import Hud from '../components/Hud.astro';
import Grain from '../components/Grain.astro';
import RegMarks from '../components/RegMarks.astro';
import Field from '../components/Field.astro';
import Sound from '../islands/sound/Sound';
import Cursor from '../islands/cursor/Cursor';
import { bedSources } from '../lib/audio-bed';

interface Props {
  title?: string;
  description?: string;
  /** The scroll-only home page carries the full instrument; /privacy-policy does not. */
  instrument?: boolean;
  /** Keep the page out of the index and out of the sitemap. /404 only. */
  noindex?: boolean;
}

const {
  title = META.title,
  description = META.description,
  instrument = false,
  noindex = false,
} = Astro.props;

/* A noindexed page gets no canonical. /404 is built once, at /404, but served
   at every unknown path, so a self-canonical would name a URL the reader is
   not on — one wrong answer is worse than no answer. */
const canonical = noindex ? null : new URL(Astro.url.pathname, Astro.site).href;

/* Every shipped encoding of the background bed, resolved at build time. The
   browser picks the one it can actually decode; an empty list means the sound
   control plays the synthesised cavity, as it did before any of this. */
const bedSrcs = bedSources();

/* Organization — never FinancialService, FinancialProduct, serviceType,
   makesOffer or areaServed. Those types describe an authorised entity offering
   a financial service, and that is a claim this company must not make in
   machine-readable form any more than it does in prose.

   `name` carries the qualified form. The bare "Guardian Holdings" is the one
   string that cannot win against an 1847 insurance conglomerate and a national
   newspaper, and it must not be the declared name. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: COMPANY.name,
  legalName: COMPANY.name,
  url: Astro.site?.href,
  email: COMPANY.email,
  description: META.schema,
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.street,
    addressLocality: COMPANY.city,
    addressCountry: 'BG',
  },
  geo: { '@type': 'GeoCoordinates', latitude: COMPANY.lat, longitude: COMPANY.lon },
  /* The checkable facts. `identifier` is the Commercial Register UIC, which is
     what a Bulgarian register lookup keys on; the VAT number is the same
     digits with the country prefix. */
  identifier: { '@type': 'PropertyValue', propertyID: 'UIC', value: COMPANY.uic },
  vatID: `BG${COMPANY.uic}`,
  foundingDate: COMPANY.founded,
  contactPoint: {
    '@type': 'ContactPoint',
    email: COMPANY.email,
    contactType: 'Enquiries',
    availableLanguage: ['English', 'Bulgarian'],
  },
  knowsAbout: [
    'Private equity', 'Liquid markets', 'Real estate',
    'Defence', 'Commodities', 'Technology', 'Financial services',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0a0907" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Guardian Holdings JSC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {/* The card and its image are declared together, which is the rule the
        previous comment here set: a summary_large_image whose image 404s
        collapses in the validator and Slack and LinkedIn cache the failure.
        /og.png is committed to public/, so it ships with the build or not at
        all — there is no path where the tag outlives the file. */}
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Guardian Holdings JSC" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The display face sets the hero, which is the LCP element. Without a
        preload the first paint measures in the fallback and the headline
        reflows — visibly, because SplitText re-splits its lines when the real
        face lands. */}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <Font cssVariable="--font-mono-src" preload />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/* Google Analytics 4. Both tags are is:inline: Astro would otherwise take
        the second one into its module graph, where `async` is meaningless and
        the gtag() shim would no longer be on window for the loader to find.

        Production only. astro dev would otherwise report every local reload as
        a real session, and the first thing anyone does with a fresh property is
        trust the numbers.

        NOT consent-gated. This fires on load and sets cookies, which in the EU
        normally requires consent first; the site has no banner and
        /privacy-policy does not name Google Analytics. Deliberate as of
        2026-09-10 and the client's call, not an oversight. */}
    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-L1Z5N4M3ET" is:inline></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-L1Z5N4M3ET');
        </script>
      </>
    )}
  </head>

  <body data-instrument={instrument ? '' : undefined}>
    {/* Set before first paint, so the no-JS rules in global.css never flash.
        Everything that needs a running script to mean anything — the HUD's
        clocks, the sound control, the live SNR — keys off this. */}
    <script is:inline>document.documentElement.dataset.js = '';</script>
    <a class="skip-link mono gh-reground" href="#main">Skip to content</a>

    {/* A direct child of body at z-index 0, behind <main>. The dust is the only
        thing left painting the shaft itself: the twelve hairline wall rings
        that used to hang here were removed — they drew the tunnel as a diagram
        of a tunnel, and the depth is carried perfectly well by the acts
        receding through the dust. The bone inversion used to need a third fixed
        sheet here too; now that an inverted act is a lit panel standing in the
        shaft, it simply paints its own ground. */}
    {instrument && <Field />}

    {instrument && (
      <>
        <RegMarks />
        <Hud />
      </>
    )}
    <Grain />
    {instrument && <div class="scanlines" aria-hidden="true"></div>}
    <div class="vignette" aria-hidden="true"></div>

    {/* main is the camera housing: in tunnel mode it goes fixed and carries the
        `perspective`, and .camera is the 3D rendering context the act planes
        are sorted in. Both are inert in the base stylesheet, so with no JS —
        or under reduced motion — this is an ordinary document that scrolls. */}
    <main id="main" tabindex="-1">
      <div class="camera">
        <slot />
      </div>
    </main>

    {/* The shaft has no height of its own once main is fixed, so this is what
        the document actually scrolls. tunnel.ts sets its height from the
        schedule it builds. */}
    {instrument && <div class="shaft-spacer" aria-hidden="true"></div>}

    {instrument && <Cursor client:only="react" />}
    {instrument && <Sound client:idle bedSources={bedSrcs} />}

    {instrument && <script src="../scripts/app.ts"></script>}
  </body>
</html>
