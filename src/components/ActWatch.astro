---
/**
 * ACT 08 — THE WATCH. Three desks with their bearings, then the standing
 * orders. Listed by post, not by name: a post is checkable and a biography is
 * not, and inventing either would be the one dishonest thing on the page.
 */
import SectionOpener from './SectionOpener.astro';
import { WATCH } from '../data/content';
---
<section class="act watch" id="watch" data-act="8" aria-labelledby="watch-title">
  <div class="stage" data-tunnel>
    <SectionOpener
      id="watch-title"
      word={WATCH.word}
      index={8}
      kicker={WATCH.kicker}
      text={WATCH.text}
    />

    <h3 class="h-statement watch__heading" data-anim="lines">{WATCH.heading}</h3>
    <p class="lede watch__lede" data-anim="lines">{WATCH.lede}</p>

    <ul class="watch__desks" data-anim-group>
      {WATCH.desks.map((t) => (
        <li class="desk" data-anim="fade-up">
          <svg class="desk__dial" viewBox="0 0 64 64" fill="none" stroke="currentColor"
               stroke-width="1" aria-hidden="true" data-anim="draw">
            <circle cx="32" cy="32" r="28" />
            <line x1="32" y1="4" x2="32" y2="12" />
            <line x1="32" y1="52" x2="32" y2="60" />
            <line x1="4" y1="32" x2="12" y2="32" />
            <line x1="52" y1="32" x2="60" y2="32" />
            <line
              class="desk__needle"
              x1="32" y1="32"
              x2={32 + 22 * Math.sin((parseInt(t.bearing, 10) * Math.PI) / 180)}
              y2={32 - 22 * Math.cos((parseInt(t.bearing, 10) * Math.PI) / 180)}
            />
          </svg>

          <span class="readout desk__bearing">Bearing {t.bearing}</span>
          <h4 class="desk__name">{t.name}</h4>
          <p class="desk__line">{t.line}</p>

          <ul class="desk__posts">
            {t.posts.map((post) => <li class="mono desk__post">{post}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <h4 class="h-section watch__sub" data-anim="lines">{WATCH.ordersHeading}</h4>
    <ol class="watch__orders">
      {WATCH.orders.map((o, i) => (
        <li class="order" data-anim="fade-up">
          <span class="readout order__idx">{String(i + 1).padStart(3, '0')}</span>
          <h5 class="order__title">{o.title}</h5>
          <p class="order__line">{o.line}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .watch__heading { max-width: 14ch; margin-bottom: clamp(20px, 2.5vw, 32px); }
  .watch__lede { margin-bottom: clamp(56px, 7vw, 96px); }

  .watch__desks {
    list-style: none; margin: 0 0 clamp(80px, 10vw, 144px); padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 48px);
  }
  .desk {
    border-top: 1px solid var(--hairline-strong);
    padding-top: 24px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .desk__dial { width: 64px; height: 64px; color: var(--ink-dim); }
  .desk__needle { stroke: var(--signal); stroke-width: 2; }
  .desk__bearing { color: var(--ink-dim); }
  .desk__name {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(24px, 2.6vw, 36px); letter-spacing: -0.028em; line-height: 1.05; margin: 0;
  }
  .desk__line { margin: 0; font-size: 0.84375rem; line-height: 1.7; color: var(--ink-muted); }
  .desk__posts { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .desk__post { color: var(--ink-dim); }
  .desk__post::before { content: '— '; color: var(--signal); }

  .watch__sub { max-width: 18ch; margin-bottom: clamp(24px, 3vw, 40px); }
  .watch__orders { list-style: none; margin: 0; padding: 0; }
  .order {
    display: grid; grid-template-columns: 80px minmax(0, 22ch) minmax(0, 1fr); gap: 32px;
    padding-block: clamp(20px, 2.5vw, 32px);
    border-top: 1px solid var(--hairline);
  }
  .order:last-child { border-bottom: 1px solid var(--hairline); }
  .order__idx { color: var(--ink-dim); }
  .order__title {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem); letter-spacing: -0.02em; margin: 0;
  }
  .order__line { margin: 0; font-size: 0.84375rem; line-height: 1.7; color: var(--ink-muted); }

  @media (max-width: 900px) {
    .watch__desks { grid-template-columns: 1fr; }
    .order { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
