---
/**
 * ACT 09 — CHANNEL. The close: the form, the address, a live Sofia clock, and
 * the legal line.
 *
 * The form posts to a Cloudflare Worker (see /worker) which relays the enquiry
 * to the inbox. Both env vars below are read at BUILD time and are safe to
 * publish: the endpoint is public by definition and a Turnstile site key is
 * designed to be seen. The secret half lives only in the Worker.
 *
 * With PUBLIC_CONTACT_ENDPOINT unset the form falls back to the prepared mail
 * draft it has always had. That is deliberate: the site can ship before the
 * Worker exists, and pressing Send is never a no-op.
 */
import { CHANNEL, COMPANY, FORM } from '../data/content';
import { bedSources } from '../lib/audio-bed';

/* The attribution below is a condition of the recording's licence, so it is
   tied to whether a recording actually shipped rather than hard-coded on. */
const hasBed = bedSources().length > 0;

const wordFit = (CHANNEL.word.length * 0.72).toFixed(2);
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<section class="act channel" id="channel" data-act="9" aria-labelledby="channel-title">
  <div class="stage" data-tunnel>
    <hr class="rule rule--strong" />

    <div class="channel__top">
      <h2 class="display-word channel__word" id="channel-title" data-anim="word" style={`--word-fit:${wordFit}`}>{CHANNEL.word}</h2>
      <p class="mono-para" data-anim="lines">{CHANNEL.text}</p>
    </div>

    <div class="channel__grid">
      <div class="channel__form-col">
        <h3 class="h-section channel__heading" data-anim="lines">{CHANNEL.formHeading}</h3>

        {/* method and action are load-bearing, not decoration. A <form> with
            neither defaults to GET, so before JS loads — or if the bundle never
            arrives — submitting put the visitor's name, address, role and whole
            message into the query string of a page URL, where it lands in
            browser history, in the Referer header of every subsequent request,
            and in any proxy log on the way. POST to the real endpoint fixes the
            leak AND makes the form work with no JavaScript at all: the Worker
            answers a form-encoded submission with an HTML page. */}
        <form class="channel__form" method="post" action="/api/contact" data-contact novalidate>
          <label class="field">
            <span class="mono field__label">Name</span>
            <input
              class="field__input"
              type="text"
              name="name"
              id="field-name"
              autocomplete="name"
              required
              aria-describedby="error-name"
            />
            {/* Persistent and in the flow, not a validation bubble. A bubble is
                transient, is dismissed by the next keystroke, and is announced
                once if at all; this is read on focus via aria-describedby and
                stays on screen until the field is fixed. */}
            <p class="field__error" id="error-name" data-error-for="name" hidden></p>
          </label>

          <label class="field">
            <span class="mono field__label">Email</span>
            <input
              class="field__input"
              type="email"
              name="email"
              id="field-email"
              autocomplete="email"
              required
              aria-describedby="error-email"
            />
            <p class="field__error" id="error-email" data-error-for="email" hidden></p>
          </label>

          {/* No default. "the role you pick marks the message" was only true
              for a visitor who touched the row: with "A founder" pre-ticked, an
              investor who skipped it was filed as a founder. Now a role is
              genuinely picked — checked in the script for the JS path and in
              the Worker for the no-JS POST, because `novalidate` means the
              browser will not enforce `required` on the group. */}
          <fieldset class="field field--roles" aria-describedby="error-role">
            <legend class="mono field__label">I am</legend>
            {CHANNEL.roles.map((role) => (
              <label class="radio">
                <input type="radio" name="role" value={role} required />
                <span class="mono">{role}</span>
              </label>
            ))}
            <p class="field__error" id="error-role" data-error-for="role" hidden></p>
          </fieldset>

          <label class="field">
            <span class="mono field__label">Message</span>
            <textarea
              class="field__input field__input--area"
              name="message"
              id="field-message"
              rows="5"
              required
              aria-describedby="error-message"
            ></textarea>
            <p class="field__error" id="error-message" data-error-for="message" hidden></p>
          </label>

          {/* Honeypot. Named like a field a bot wants to fill, hidden from
              people, never read by anything but the Worker. */}
          <div class="field--trap" aria-hidden="true">
            <label>
              Company
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          {turnstileKey && (
            <div class="channel__turnstile cf-turnstile" data-sitekey={turnstileKey} data-theme="dark"></div>
          )}

          {/* The only consent gate on the site. No banner interrupts anyone, so
              nothing is agreed to until a visitor actually sends something —
              and then only about the message itself. Required on both paths:
              validated here for the JS path and re-checked in the Worker, which
              is what the no-JS POST hits. */}
          <label class="field consent">
            <span class="consent__row">
              <input type="checkbox" name="consent" id="field-consent" value="yes" required aria-describedby="error-consent" />
              <span class="mono consent__text">
                {FORM.consentLabel} <a href="/privacy-policy/">What we do with it</a>
              </span>
            </span>
            <p class="field__error" id="error-consent" data-error-for="consent" hidden></p>
          </label>

          {/* ABOVE the button, deliberately. It reports on the press, and below
              the button on a phone it was off the bottom of the screen at the
              exact moment it had something to say. */}
          <p class="readout channel__status" data-contact-status role="status" hidden></p>

          <button class="door door--primary" type="submit">
            <span data-send-label>Send</span>
            <svg viewBox="0 0 24 8" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="square" aria-hidden="true">
              <path d="M0 4h22M18 .5L22 4l-4 3.5" />
            </svg>
          </button>

          <p class="readout channel__note">{CHANNEL.formNote}</p>

          {/* Only when there IS a bot check to fail. Turnstile renders from its
              own script, so with no JS the widget never appears and the Worker
              rejects the submission — that is worth warning about, and the
              address is the plain path around it.

              With no key set there is nothing to warn about: the form is a
              plain POST to /api/contact, the Worker answers a form-encoded
              submission with an HTML page, and `required` on the consent box is
              enforced server-side precisely because `novalidate` means the
              browser will not do it. Telling a no-JS visitor the form needs
              JavaScript, while the form works, sends them away from something
              that would have worked. This block and the widget above appear and
              vanish together, on the same condition. */}
          {turnstileKey && (
            <noscript>
              <p class="readout channel__status" data-state="info">
                This form needs JavaScript for its bot check. Write to
                <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a> instead.
              </p>
            </noscript>
          )}
        </form>
      </div>

      <div class="channel__meta">
        <div class="channel__block">
          <p class="eyebrow">Write</p>
          <a class="channel__mail" href={`mailto:${COMPANY.email}`} data-cursor-label="Write">{COMPANY.email}</a>
        </div>

        <div class="channel__block">
          <p class="eyebrow">Visit</p>
          <address class="channel__address">
            {COMPANY.name}<br />
            {COMPANY.street}<br />
            {COMPANY.city}, {COMPANY.country}
          </address>
        </div>

        <div class="channel__block">
          <p class="eyebrow">Locate</p>
          <p class="readout">{COMPANY.coords}</p>
          {/* The zone label is computed with the time. It was the literal
              "EET", which Sofia leaves for EEST from the last Sunday of March
              to the last Sunday of October — seven months of every year. */}
          <p class="readout channel__clock">Local <span data-channel-clock>--:--:--</span>{' '}<span data-channel-zone></span></p>
        </div>
      </div>
    </div>

    <footer class="channel__footer">
      <hr class="rule" />
      <p class="h-statement channel__ask" data-anim="lines">{CHANNEL.footerAsk}</p>
      <p class="mono-para channel__footpara" data-anim="lines">{CHANNEL.footerPara}</p>

      <p class="channel__brand">{CHANNEL.brandLine}</p>

      <div class="channel__legal">
        {/* Name, seat and UIC: what Bulgarian Commerce Act Art. 13 asks a
            trader's website to carry, and the one fact here a counterparty can
            check in a register. The full address is in the Visit block. */}
        <p class="readout">© {new Date().getFullYear()} {COMPANY.name} · UIC {COMPANY.uic} · Seat: {COMPANY.city}</p>
        <p class="readout channel__legalline">{CHANNEL.legal}</p>
        <a class="readout channel__privacy" href="/privacy-policy/">Privacy policy</a>
        {hasBed && (
          <p class="readout channel__credit">
            {CHANNEL.soundCredit.text}{' '}
            <a href={CHANNEL.soundCredit.sourceHref} rel="noopener noreferrer" target="_blank">
              {CHANNEL.soundCredit.performer}<span class="sr-only"> (opens in a new tab)</span>
            </a>.{' '}
            <a href={CHANNEL.soundCredit.href} rel="license noopener noreferrer" target="_blank">
              {CHANNEL.soundCredit.licence}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        )}
      </div>
    </footer>
  </div>
</section>

{turnstileKey && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<style>
  .channel__top {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 48px; flex-wrap: wrap;
    margin-block: clamp(16px, 2vw, 32px) clamp(56px, 7vw, 104px);
  }
  .channel__word {
    font-size: min(
      clamp(48px, 12vw, 180px),
      calc((100vw - 2 * var(--gutter)) / var(--word-fit))
    );
  }
  .channel__top > .mono-para { flex: 0 1 44ch; min-width: min(44ch, 100%); }

  .channel__grid {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    margin-bottom: clamp(80px, 10vw, 144px);
  }
  .channel__heading { max-width: 20ch; margin-bottom: clamp(28px, 3.5vw, 44px); }

  .channel__form { display: flex; flex-direction: column; gap: 24px; max-width: 52ch; position: relative; }

  /* Off-screen, not display:none: a bot that skips hidden inputs still fills
     what is in the DOM, and a screen reader never reaches it (aria-hidden,
     tabindex -1). */
  .field--trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* Reserve the widget's height so the button does not jump when it loads. */
  .channel__turnstile { min-height: 65px; }
  .field { display: flex; flex-direction: column; gap: 8px; border: 0; padding: 0; margin: 0; }
  .field__label { color: var(--ink-dim); }
  .field__input {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--hairline-strong);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 12px 0;
    transition: border-color var(--dur-fast);
  }
  /* The outline stays. `outline: none` used to live here, leaving a 1px change
     of underline colour as the ONLY focus cue — no cue at all for anyone who
     cannot separate those two colours — and it silently beat the site's global
     focus ring, because :where() has zero specificity and this selector does
     not. Text fields are treated as focus-visible on click too, which is
     correct: a focused field should say so however it was reached. */
  .field__input:focus-visible {
    outline: 2px solid var(--signal-hi);
    outline-offset: 3px;
  }
  .field__input:focus { border-bottom-color: var(--signal); }

  /* Inline, persistent, and referenced by the input's aria-describedby, so it
     is read on focus rather than announced once and lost. */
  .field__error {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--signal-hi);
    margin: 0;
  }
  .field__error[hidden] { display: none; }
  .field__input[aria-invalid='true'] { border-bottom-color: var(--signal-hi); }
  .field__input--area { resize: vertical; }

  .field--roles { display: flex; flex-direction: row; align-items: center; gap: 24px; flex-wrap: wrap; }
  .field--roles legend { float: left; width: 100%; margin-bottom: 8px; }
  .field--roles .field__error { flex-basis: 100%; }
  .radio { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; color: var(--ink-muted); }
  .radio input { accent-color: var(--signal); }

  .consent__row { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
  .consent input { accent-color: var(--signal); margin: 2px 0 0; flex: none; }
  .consent__text { color: var(--ink-muted); max-width: 46ch; line-height: 1.6; letter-spacing: 0.06em; }
  .consent__text a { color: var(--ink-muted); text-decoration: underline; text-underline-offset: 4px; }
  .consent__text a:hover { color: var(--signal-hi); }
  .consent input:focus-visible { outline: 2px solid var(--signal-hi); outline-offset: 3px; }

  .channel__note { color: var(--ink-dim); max-width: 44ch; line-height: 1.6; letter-spacing: 0.08em; }
  /* Success and failure used to render identically — same element, same class,
     same accent colour — so the only difference between "Sent" and "That did
     not send" was reading the words. The words still carry the meaning for a
     screen reader; these states carry it for a glance. Differentiated by rule
     weight and ground as well as hue, because colour alone is not a
     distinction for everyone. */
  .channel__status {
    max-width: 44ch;
    line-height: 1.6;
    letter-spacing: 0.08em;
    margin: 0;
    padding: 10px 0 10px 16px;
    border-left: 1px solid var(--hairline-strong);
    color: var(--ink-muted);
  }
  .channel__status[hidden] { display: none; }
  /* In flight. Quiet: nothing has happened yet. */
  .channel__status[data-state='info'] { color: var(--ink-muted); }
  /* It sent. The reader is the subject, so the copy sits in reading ink. */
  .channel__status[data-state='ok'] {
    color: var(--ink);
    border-left: 2px solid var(--signal-hi);
  }
  /* It did not. Heavier rule, tinted ground, accent text — three signals, not
     one, and the sentence itself still says what to do next. */
  .channel__status[data-state='error'] {
    color: var(--signal-hi);
    border-left: 2px solid var(--signal-hi);
    background: var(--signal-dim);
    padding-right: 16px;
  }

  .channel__meta { display: flex; flex-direction: column; gap: clamp(32px, 4vw, 52px); }
  .channel__block { display: flex; flex-direction: column; gap: 12px; }
  .channel__mail {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem); letter-spacing: -0.02em;
    border-bottom: 1px solid var(--hairline-strong);
    align-self: flex-start; padding-bottom: 4px;
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .channel__mail:hover { color: var(--signal-hi); border-color: var(--signal); }
  .channel__address { font-style: normal; font-size: 0.875rem; line-height: 1.7; color: var(--ink-muted); }
  .channel__clock span { color: var(--signal-hi); }

  .channel__footer { border-top: 0; }
  .channel__ask { margin-block: clamp(40px, 5vw, 72px) clamp(20px, 2.5vw, 32px); max-width: 16ch; }
  .channel__footpara { margin-bottom: clamp(28px, 3.5vw, 44px); }
  .channel__brand {
    font-size: 0.875rem; line-height: 1.7; color: var(--ink-muted);
    max-width: 62ch; margin: 0 0 clamp(48px, 6vw, 80px);
  }

  .channel__legal {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 32px; flex-wrap: wrap;
    border-top: 1px solid var(--hairline); padding-top: 24px;
  }
  .channel__legalline { max-width: 60ch; line-height: 1.6; letter-spacing: 0.08em; }
  /* Both footer links sat at 19px and 15px tall. inline-block lets the padding
     count toward the 24px target minimum without moving the baseline. */
  .channel__privacy {
    display: inline-block;
    padding-block: 4px;
    border-bottom: 1px solid var(--hairline-strong);
  }
  .channel__privacy:hover { color: var(--signal-hi); }

  /* Its own line under the legal row rather than a fourth column in it.
     text-transform is cleared because .readout upper-cases, and a performer's
     name in a credit should read the way that person writes it. */
  .channel__credit {
    flex-basis: 100%;
    text-transform: none;
    letter-spacing: 0.06em;
    line-height: 1.7;
    max-width: 70ch;
  }
  .channel__credit a {
    display: inline-block;
    padding-block: 5px;
    color: inherit;
    border-bottom: 1px solid var(--hairline-strong);
  }
  .channel__credit a:hover { color: var(--signal-hi); }

  @media (max-width: 900px) {
    .channel__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 767px) {
    /* One column here, so the address runs the full width and its tail reached
       under the fixed sound control in the corner. It is a 31-character token
       that cannot wrap anywhere sensible, so the fix is to set it smaller
       rather than to let it break mid-domain. */
    .channel__mail { font-size: 1rem; }
  }
</style>

<script>
  import { COMPANY, FORM } from '../data/content';

  /* Live Sofia clock — direct init, no lifecycle gate. */
  const clock = document.querySelector<HTMLElement>('[data-channel-clock]');
  /* Seconds, because the placeholder promises three groups and the interval
     is one second; and the zone name, because it was hard-coded. */
  const zone = document.querySelector<HTMLElement>('[data-channel-zone]');
  if (clock) {
    const timeFmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: COMPANY.tz, hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
    });
    const zoneFmt = new Intl.DateTimeFormat('en-GB', { timeZone: COMPANY.tz, timeZoneName: 'short' });
    const tick = () => {
      const now = new Date();
      clock.textContent = timeFmt.format(now);
      if (zone) zone.textContent = zoneFmt.formatToParts(now).find((p) => p.type === 'timeZoneName')?.value ?? '';
    };
    tick();
    let timer = window.setInterval(tick, 1000);
    document.addEventListener('visibilitychange', () => {
      window.clearInterval(timer);
      if (!document.hidden) { tick(); timer = window.setInterval(tick, 1000); }
    });
  }

  /* Same-origin by default: the endpoint is served by the site's own Worker
     (signal/worker/contact.ts), so there is nothing to configure per
     environment and no cross-origin preflight. The env var stays as an
     override for pointing a local build at a deployed endpoint. Set it to the
     empty string to force the original mail-draft behaviour. */
  const ENDPOINT: string = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '/api/contact';

  /* Bots submit instantly. The Worker judges this together with the honeypot
     and answers 200 either way, so a bot never learns which one caught it. */
  const readyAt = Date.now();

  declare global {
    interface Window { turnstile?: { reset: (el?: HTMLElement) => void } }
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;

  const label = button?.querySelector<HTMLElement>('[data-send-label]') ?? null;

  /* `state` drives the visual treatment. The SENTENCE still carries the meaning
     for a screen reader — the states are so a sighted reader can tell "Sent"
     from "That did not send" without reading either. */
  type Tone = 'info' | 'ok' | 'error';
  const say = (text: string, tone: Tone = 'info') => {
    if (!status) return;
    status.textContent = text;
    status.dataset.state = tone;
    status.hidden = false;
  };

  /* Disabled AND visibly disabled AND relabelled. It was already disabled for
     the whole request and looked identical while it was. */
  const busy = (on: boolean) => {
    if (button) button.disabled = on;
    if (label) label.textContent = on ? 'Sending.' : 'Send';
  };

  /* A radio group comes back as a RadioNodeList; its first radio stands in
     for the group wherever an element is needed (focus, aria-invalid). */
  const field = (name: string): HTMLInputElement | HTMLTextAreaElement | null => {
    const item = form?.elements.namedItem(name) ?? null;
    if (item instanceof RadioNodeList) return (item.item(0) as HTMLInputElement | null) ?? null;
    return item as HTMLInputElement | HTMLTextAreaElement | null;
  };

  const errorFor = (name: string) =>
    form?.querySelector<HTMLElement>(`[data-error-for="${name}"]`) ?? null;

  /* Was reportValidity() alone: a transient platform bubble, dismissed by the
     next keystroke, announced once if at all, and invisible to anything that
     reads the page rather than watching it. The message now lives in the
     document, is wired to the input through aria-describedby so it is read
     whenever the field takes focus, and the field is marked aria-invalid so
     the state is exposed as well as the text. Our strings, not the platform's:
     each says what happened and what to do, then stops. */
  function complain(name: string, message: string): boolean {
    const el = field(name);
    if (!el) return false;
    const slot = errorFor(name);
    if (slot) {
      slot.textContent = message;
      slot.hidden = false;
    }
    el.setAttribute('aria-invalid', 'true');
    el.focus();
    // Clear on the next edit, or a fixed field keeps reporting the old fault.
    // A radio group clears on a change to any of its radios, not only the one
    // that took focus.
    const radio = el.type === 'radio';
    const nodes = radio
      ? Array.from(form?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`) ?? [])
      : [el];
    nodes.forEach((node) => node.addEventListener(radio ? 'change' : 'input', () => clearError(name), { once: true }));
    return true;
  }

  function clearError(name: string): void {
    const el = field(name);
    el?.removeAttribute('aria-invalid');
    const slot = errorFor(name);
    if (slot) {
      slot.textContent = '';
      slot.hidden = true;
    }
  }

  /* The prepared mail draft. Once the only path, now also the recovery path:
     if the send fails, what the visitor typed is handed to their mail client
     rather than lost. The subject and the signature block are a contract with
     admin/src/lib/enquiries.ts, which parses these messages back — the Worker
     builds the identical shape. */
  const draft = (name: string, email: string, role: string, message: string): boolean => {
    const subject = role === 'An investor' ? `Investor · ${name}` : `Founder · ${name}`;
    const body = `${message}\n\n—\n${name}\n${email}\n${role}`;
    try {
      window.location.href =
        `mailto:${COMPANY.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      return true;
    } catch {
      return false;
    }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const role = String(data.get('role') ?? '');
    const message = String(data.get('message') ?? '').trim();

    // Clear anything left over from a previous submit, or a now-valid field
    // keeps reporting the old complaint.
    for (const key of ['name', 'email', 'role', 'message', 'consent']) clearError(key);
    if (!name) return void complain('name', FORM.nameRequired);
    if (!email) return void complain('email', FORM.emailRequired);
    if (!field('email')?.validity.valid) return void complain('email', FORM.emailInvalid);
    if (!role) return void complain('role', FORM.roleRequired);
    if (!message) return void complain('message', FORM.messageRequired);
    // Last, so the visitor is not asked to agree to sending something they have
    // not finished writing.
    if (!data.get('consent')) return void complain('consent', FORM.consentRequired);

    if (!ENDPOINT) {
      const opened = draft(name, email, role, message);
      return void say(opened ? FORM.mailOpened : FORM.mailFailed, opened ? 'ok' : 'error');
    }

    // Turnstile's implicit render drops this input into the form itself. Only
    // demand it when the widget is actually on the page.
    const token = String(data.get('cf-turnstile-response') ?? '');
    if (form.querySelector('.cf-turnstile') && !token) return void say(FORM.botCheck, 'error');

    busy(true);
    say(FORM.sending, 'info');

    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          role,
          message,
          token,
          company: String(data.get('company') ?? ''),
          elapsed: Date.now() - readyAt,
        }),
      });
      // 503 + unconfigured is the endpoint saying "no mail account yet", which
      // is a deployment state and not a fault. The visitor gets the prepared
      // draft with no failure message, exactly as if no backend were wired —
      // because as far as they are concerned, none is.
      if (res.status === 503) {
        const body = (await res.json().catch(() => null)) as { unconfigured?: boolean } | null;
        if (body?.unconfigured) {
          const opened = draft(name, email, role, message);
          return void say(opened ? FORM.mailOpened : FORM.mailFailed, opened ? 'ok' : 'error');
        }
      }
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      window.turnstile?.reset();
      say(FORM.sent, 'ok');
    } catch {
      say(FORM.sendFailed, 'error');
      if (!draft(name, email, role, message)) say(FORM.mailFailed, 'error');
    } finally {
      busy(false);
    }
  });
</script>
